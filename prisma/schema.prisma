generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// PROPERTIES TABLE
// ─────────────────────────────────────────
model Property {
  id          String     @id @default(cuid())
  title       String
  type        String     // "house" | "apartment" | "plot" | "commercial"
  listingType String     @default("sale") // "rent" | "sale"
  price       Float
  currency    String     @default("USD") // "USD" | "FRW"
  location    String
  size        Float      // in sqft or acres
  bedrooms    Int?       // null for plots
  bathrooms   Int?       // null for plots
  description String
  images      String     // JSON stringified array of URLs
  videos      String     // JSON stringified array of URLs
  status      String     @default("available") // "available" | "pending" | "sold"
  featured    Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  inquiries   Inquiry[]
}

// ─────────────────────────────────────────
// INQUIRIES TABLE
// ─────────────────────────────────────────
model Inquiry {
  id         String    @id @default(cuid())
  name       String
  email      String
  phone      String
  message    String
  isRead     Boolean   @default(false)
  createdAt  DateTime  @default(now())

  property   Property? @relation(fields: [propertyId], references: [id])
  propertyId String?
}

// ─────────────────────────────────────────
// ADMIN USERS TABLE
// ─────────────────────────────────────────
model User {
  id            String   @id @default(cuid())
  name          String?
  email         String   @unique
  password      String   // bcrypt hashed
  role          String   @default("admin")
  isSuperAdmin  Boolean  @default(false)
  createdAt     DateTime @default(now())
}

// ─────────────────────────────────────────
// PROPERTY SUBMISSIONS TABLE (Client-facing)
// ─────────────────────────────────────────
model PropertySubmission {
  id                String   @id @default(cuid())
  ownerName         String
  phoneNumber       String
  email             String
  propertyType      String   // "house" | "apartment" | "plot" | "commercial"
  listingStatus     String   // "forSale" | "forRent"
  location          String
  askingPrice       Float
  currency          String   // "RWF" | "USD"
  bedrooms          Int?
  bathrooms         Int?
  description       String
  preferredContact  String   // "phone" | "whatsapp" | "email"
  status            String   @default("pending") // "pending" | "reviewed" | "contacted"
  isReviewed        Boolean  @default(false)
  createdAt         DateTime @default(now())
}

// ─────────────────────────────────────────
// NEWSLETTER SUBSCRIBERS TABLE
// ─────────────────────────────────────────
model NewsletterSubscriber {
  id               String   @id @default(cuid())
  email            String   @unique
  subscribedAt     DateTime @default(now())
}
